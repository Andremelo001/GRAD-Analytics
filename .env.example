# Copie para .env e ajuste o que precisar. Nenhum valor aqui é segredo —
# são parâmetros de operação do pipeline de dados (ver backend/README.md, seção 4).

# --- Ambiente e logging -----------------------------------------------------
ENV=local
LOG_LEVEL=INFO

# --- HTTP (download dos arquivos do INEP) -----------------------------------
HTTP_TIMEOUT=30.0
HTTP_USER_AGENT="GRAD-Analytics/0.1 (data pipeline)"
HTTP_MAX_RETRIES=3
HTTP_BACKOFF=2.0

# --- Módulo Qualidade (CPC) --------------------------------------------------
QUALIDADE_LANDING_URL=https://www.gov.br/inep/pt-br/acesso-a-informacao/dados-abertos/indicadores-educacionais/indicadores-de-qualidade-da-educacao-superior
# < 2015 tem grão diferente (IES x Área, sem Código do Curso) — não mexer sem
# revisar backend/app/modules/qualidade/domain/schema.py e colunas_inep.json
QUALIDADE_MIN_YEAR=2015
# vazio = sem limite máximo: um CPC novo entra sozinho
QUALIDADE_MAX_YEAR=

# --- Módulo Trajetória --------------------------------------------------------
TRAJETORIA_LANDING_URL=https://www.gov.br/inep/pt-br/acesso-a-informacao/dados-abertos/indicadores-educacionais/indicadores-de-trajetoria-da-educacao-superior
# Vazio = sem restrição, processa todas as faixas de anos encontradas na página.
TRAJETORIA_MIN_YEAR=
TRAJETORIA_MAX_YEAR=

# --- Exportação dos CSVs -----------------------------------------------------
# Acima deste tamanho (em MB) o CSV é gravado como .csv.gz em vez de .csv.
CSV_GZIP_THRESHOLD_MB=40

# --- Nomes das colunas do INEP -------------------------------------------------
# Arquivo com os nomes das colunas dos arquivos do INEP e os rótulos das
# categorias (guia: COLUNAS_INEP.md). Vazio = colunas_inep.json na raiz do repo.
COLUNAS_INEP_FILE=

# --- Módulo Dashboard (recorta qualidade.csv + trajetoria.csv por unidade) ----
# Código INEP da instituição. As unidades vêm da lista de cursos do SIGAA
# (unidades_ufc.json): cada um vira um JSON em processed/dashboard/<unidade>.json.
DASHBOARD_CODIGO_IES=583

# --- Módulo Unidades (lista de cursos por unidade do SIGAA) -----------------------
# Página pública "Consulta de Cursos" de graduação do SIGAA da UFC.
SIGAA_CURSOS_URL=https://si3.ufc.br/sigaa/public/curso/lista.jsf?nivel=G&aba=p-ensino
# Vazio = unidades_ufc.json / unidades_ufc_ajustes.json na raiz do repo.
UNIDADES_UFC_FILE=
UNIDADES_UFC_AJUSTES_FILE=
